})

VidaTab:AddSection({
    Name = "Farm de Vida"
})

CriarToggle(VidaTab, "Bench")
CriarToggle(VidaTab, "PushUp")
CriarToggle(VidaTab, "SitUp")

local ConfigTab = Window:MakeTab({
    Name = "Configurações",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

ConfigTab:AddSection({
    Name = "Otimização"
})

ConfigTab:AddToggle({
    Name = "Anti-AFK",
    Default = false,

    Callback = function(valor)
        if valor then
            if AntiAFKConnection then
                AntiAFKConnection:Disconnect()
                AntiAFKConnection = nil
            end

            AntiAFKConnection = LocalPlayer.Idled:Connect(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        else
            if AntiAFKConnection then
                AntiAFKConnection:Disconnect()
                AntiAFKConnection = nil
            end
        end
    end
})

ConfigTab:AddToggle({
    Name = "Render 01",
    Default = false,

    Callback = function(valor)
        pcall(function()
            if valor then
                if RenderOriginal == nil then
                    RenderOriginal = settings().Rendering.QualityLevel
                end

                settings().Rendering.QualityLevel =
                    Enum.QualityLevel.Level01
            else
                if RenderOriginal ~= nil then
                    settings().Rendering.QualityLevel = RenderOriginal
                    RenderOriginal = nil
                end
            end
        end)
    end
})

OrionLib:Init()
